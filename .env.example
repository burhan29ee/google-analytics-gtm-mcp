# Absolute path to your Google Cloud service-account JSON key file.
# The same key is used for both Google Analytics 4 and Google Tag Manager, so
# the service account must be granted access on BOTH:
#   - the target GA4 account/property (Analytics admin UI), and
#   - the target GTM account/container (Tag Manager admin UI).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json
